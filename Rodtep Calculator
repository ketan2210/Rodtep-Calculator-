
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Rodtep Calculator</title>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  padding: 20px;
  font-family: Arial, sans-serif;
  background: #f1f5f9;
  color: #172033;
}

.container {
  max-width: 650px;
  margin: auto;
}

header {
  background: #12345a;
  color: white;
  padding: 24px 18px;
  text-align: center;
  border-radius: 14px;
  margin-bottom: 20px;
}

header h1 {
  margin: 0 0 8px;
}

header p {
  margin: 0;
  color: #d5e4f7;
}

.card {
  background: white;
  padding: 20px;
  border-radius: 14px;
  margin-bottom: 18px;
  box-shadow: 0 3px 12px #0000000d;
}

h2 {
  font-size: 19px;
  margin-top: 0;
  color: #12345a;
}

label {
  display: block;
  margin: 14px 0 6px;
  font-size: 14px;
  font-weight: 600;
}

input, select {
  width: 100%;
  padding: 12px;
  border: 1px solid #cbd5e1;
  border-radius: 8px;
  font-size: 16px;
  background: white;
  color: #172033;
}

input:focus, select:focus {
  outline: 2px solid #60a5fa;
  border-color: #2563eb;
}

.result {
  background: #eaf3ff;
  padding: 14px;
  border-radius: 9px;
  margin-top: 16px;
  overflow-wrap: anywhere;
}

.result div {
  margin: 8px 0;
}

.result strong {
  color: #12345a;
}

.value {
  font-size: 19px;
  font-weight: bold;
  color: #0757a5;
}

.note {
  font-size: 12px;
  color: #64748b;
  line-height: 1.5;
}

button {
  width: 100%;
  border: none;
  padding: 12px;
  margin-top: 12px;
  border-radius: 8px;
  font-size: 15px;
  font-weight: bold;
  cursor: pointer;
}

.primary {
  background: #12345a;
  color: white;
}

.secondary {
  background: #e2e8f0;
  color: #172033;
}

footer {
  text-align: center;
  color: #64748b;
  font-size: 12px;
  padding: 10px;
}

@media print {
  body {
    background: white;
    padding: 0;
  }

  .card, header {
    box-shadow: none;
    border: 1px solid #ddd;
    break-inside: avoid;
  }

  button {
    display: none;
  }
}
</style>
</head>

<body>
<div class="container">

<header>
  <h1>RODTEP CALCULATOR</h1>
  <p>Import Clearance & Valuation Tools</p>
</header>

<!-- CALCULATOR 1 -->
<section class="card">
  <h2>1. Invoice & Assessable Value</h2>

  <label for="weight">Net Weight (in KGs)</label>
  <input id="weight" type="number" min="0" step="any"
         placeholder="Enter net weight">

  <label for="unitUsd">Unit Price (USD)</label>
  <input id="unitUsd" type="number" min="0" step="any"
         placeholder="Enter unit price in USD">

  <label for="terms">Payment Terms</label>
  <select id="terms">
    <option value="CNF">CNF</option>
    <option value="CIF">CIF</option>
  </select>

  <label for="usdRate">USD to INR Rate</label>
  <input id="usdRate" type="number" min="0" step="any"
         placeholder="Enter exchange rate">

  <div class="result" aria-live="polite">
    <div>Invoice Value (USD):<br>
      <strong id="invoiceUsd" class="value">—</strong>
    </div>

    <div>Invoice Value (INR):<br>
      <strong id="invoiceInr">—</strong>
    </div>

    <div>Assessable Value (INR):<br>
      <strong id="assessable" class="value">—</strong>
    </div>

    <div>Unit Price (INR/KG):<br>
      <strong id="unitInr">—</strong>
    </div>
  </div>

  <p class="note">
    CNF: Invoice Value (INR) + 1.125% of Invoice Value.
    CIF: Invoice Value (INR), as specified for this calculator.
    Verify the applicable customs valuation rules before using
    these figures for an actual Bill of Entry.
  </p>

  <button class="secondary" onclick="clearInvoice()">
    Clear Fields
  </button>
</section>

<!-- CALCULATOR 2 -->
<section class="card">
  <h2>2. Assessable Value from BCD</h2>

  <label for="bcdPercent">BCD Percentage (%)</label>
  <input id="bcdPercent" type="number" min="0" step="any"
         placeholder="Example: 7.5">

  <label for="bcdAmount">BCD Amount (INR)</label>
  <input id="bcdAmount" type="number" min="0" step="any"
         placeholder="Enter BCD amount">

  <div class="result" aria-live="polite">
    <div>Assessable Value (INR):<br>
      <strong id="bcdResult" class="value">—</strong>
    </div>
  </div>

  <p class="note">
    Formula: BCD Amount ÷ BCD Percentage × 100.
    This assumes the entered BCD amount corresponds to the
    entered rate applied to the assessable value.
  </p>

  <button class="secondary" onclick="clearBcd()">
    Clear Fields
  </button>
</section>

<!-- CALCULATOR 3 -->
<section class="card">
  <h2>3. Net Weight from Assessable Value</h2>

  <label for="avWeight">Assessable Value (INR)</label>
  <input id="avWeight" type="number" min="0" step="any"
         placeholder="Enter assessable value">

  <label for="priceWeight">Unit Price (INR/KG)</label>
  <input id="priceWeight" type="number" min="0" step="any"
         placeholder="Enter unit price in INR">

  <div class="result" aria-live="polite">
    <div>Calculated Net Weight (KG):<br>
      <strong id="weightResult" class="value">—</strong>
    </div>
  </div>

  <p class="note">
    Formula: Assessable Value ÷ Unit Price (INR/KG).
    Ensure both values use consistent units and valuation bases.
  </p>

  <button class="secondary" onclick="clearWeight()">
    Clear Fields
  </button>
</section>

<section class="card">
  <h2>Actions</h2>
  <button class="primary" onclick="window.print()">
    Print / Save as PDF
  </button>
  <p class="note">
    This tool performs calculations in your browser. It does
    not submit or save your shipment data to a server.
  </p>
</section>

<footer>
  Rodtep Calculator · For calculation assistance only
</footer>

</div>

<script>
const $ = id => document.getElementById(id);

function number(id) {
  const raw = $(id).value.trim();
  if (raw === "") return null;

  const n = Number(raw);
  return Number.isFinite(n) && n >= 0 ? n : null;
}

function format(value, digits = 2) {
  if (!Number.isFinite(value)) return "Invalid value";

  return value.toLocaleString("en-IN", {
    minimumFractionDigits: digits,
    maximumFractionDigits: digits
  });
}

function display(id, value) {
  $(id).textContent = value;
}

function calculateInvoice() {
  const weight = number("weight");
  const unitUsd = number("unitUsd");
  const rate = number("usdRate");
  const terms = $("terms").value;

  const invoiceUsd =
    weight !== null && unitUsd !== null
      ? weight * unitUsd
      : null;

  const invoiceInr =
    invoiceUsd !== null && rate !== null
      ? invoiceUsd * rate
      : null;

  const assessable =
    invoiceInr !== null
      ? terms === "CNF"
        ? invoiceInr * 1.01125
        : invoiceInr
      : null;

  const unitInr =
    assessable !== null && weight !== null && weight > 0
      ? assessable / weight
      : null;

  display(
    "invoiceUsd",
    invoiceUsd !== null ? "$ " + format(invoiceUsd) : "—"
  );

  display(
    "invoiceInr",
    invoiceInr !== null ? "₹ " + format(invoiceInr) : "—"
  );

  display(
    "assessable",
    assessable !== null ? "₹ " + format(assessable) : "—"
  );

  display(
    "unitInr",
    unitInr !== null ? "₹ " + format(unitInr, 4) : "—"
  );
}

function calculateBcd() {
  const percent = number("bcdPercent");
  const amount = number("bcdAmount");

  const result =
    percent !== null && percent > 0 && amount !== null
      ? (amount / percent) * 100
      : null;

  display(
    "bcdResult",
    result !== null ? "₹ " + format(result) : "—"
  );
}

function calculateWeight() {
  const av = number("avWeight");
  const price = number("priceWeight");

  const result =
    av !== null && price !== null && price > 0
      ? av / price
      : null;

  display(
    "weightResult",
    result !== null ? format(result, 3) + " KG" : "—"
  );
}

function clearInvoice() {
  ["weight", "unitUsd", "usdRate"].forEach(id => {
    $(id).value = "";
  });
  $("terms").value = "CNF";
  calculateInvoice();
}

function clearBcd() {
  ["bcdPercent", "bcdAmount"].forEach(id => {
    $(id).value = "";
  });
  calculateBcd();
}

function clearWeight() {
  ["avWeight", "priceWeight"].forEach(id => {
    $(id).value = "";
  });
  calculateWeight();
}

["weight", "unitUsd", "usdRate"].forEach(id => {
  $(id).addEventListener("input", calculateInvoice);
});

$("terms").addEventListener("change", calculateInvoice);

["bcdPercent", "bcdAmount"].forEach(id => {
  $(id).addEventListener("input", calculateBcd);
});

["avWeight", "priceWeight"].forEach(id => {
  $(id).addEventListener("input", calculateWeight);
});
</script>

</body>
</html>
